---
import { projects, projectsIntro } from '../data/site';
---

<section id="projects" class="wrap section" aria-labelledby="projects-title">
  <header class="head">
    <h2 id="projects-title" class="title">Projects</h2>
    <p class="muted intro">{projectsIntro}</p>
  </header>

  <div class="list" data-stack>
    {
      projects.map((p) => (
        <div class="stack-item">
          <article class="card project reveal">
            <div class="body">
              <h3 class="name accent">{p.name}</h3>
              <p class="text">{p.text}</p>
              <a class="btn sm" href={p.href} target="_blank" rel="noopener">
                View source <span class="sr-only">for {p.name} on GitHub</span>
              </a>
            </div>
            <div class="media">
              <img src={p.image} alt="" loading="lazy" width="1024" height="1024" />
            </div>
          </article>
        </div>
      ))
    }
  </div>
</section>

<style>
  .head {
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .intro {
    max-width: 26rem;
    font-size: 0.9rem;
  }
  .list {
    display: grid;
    gap: 0.75rem;
  }
  /* stacking cards: each one pins near the top, then shrinks and dims as the next slides over it.
     --p (0 → 1) is set from scroll position in the script below */
  .stack-item {
    position: sticky;
    top: var(--gutter);
    --p: 0;
    transform: scale(calc(1 - 0.1 * var(--p)));
    filter: brightness(calc(1 - var(--stack-dim) * var(--p)));
    will-change: transform, filter;
  }
  .list {
    --stack-dim: 0.8;
  }
  :global([data-theme='light']) .list {
    --stack-dim: 0.12;
  }
  .project {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: clamp(22rem, 40vw, 34rem);
    overflow: hidden;
  }
  .body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 1.5rem;
    padding: clamp(1.5rem, 4vw, 4rem);
  }
  .name {
    font-size: 0.95rem;
    font-weight: 400;
  }
  .text {
    font-size: clamp(1.25rem, 2.2vw, 1.85rem);
    line-height: 1.3;
    letter-spacing: -0.02em;
    max-width: 30rem;
  }
  .media {
    position: relative;
    overflow: hidden;
    background: var(--surface-2);
  }
  .media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .project:hover .media img {
    transform: scale(1.04);
  }

  @media (max-width: 760px) {
    .project {
      grid-template-columns: 1fr;
      min-height: calc(100svh - 2 * var(--gutter));
    }
    .media {
      order: -1;
      aspect-ratio: 4 / 3;
    }
  }
</style>

<script>
  // Drive the stacking effect. A card's progress runs from 0 when it pins to 1 when the
  // next card has slid up to the same pin offset and covers it.
  const list = document.querySelector<HTMLElement>('[data-stack]');
  const items = list ? [...list.querySelectorAll<HTMLElement>(':scope > .stack-item')] : [];
  if (items.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    // scroll events already fire at most once per frame, so no rAF throttle is needed
    const update = () => {
      const pin = parseFloat(getComputedStyle(items[0]).top) || 0;
      const gap = parseFloat(getComputedStyle(list!).rowGap) || 0;
      items.forEach((item, i) => {
        const next = items[i + 1];
        if (!next) return;
        // offsetHeight ignores the scale transform, so this distance stays stable
        const travel = item.offsetHeight + gap;
        const p = Math.min(Math.max(1 - (next.getBoundingClientRect().top - pin) / travel, 0), 1);
        item.style.setProperty('--p', (1 - (1 - p) ** 2).toFixed(4)); // ease-out
      });
    };
    addEventListener('scroll', update, { passive: true });
    addEventListener('resize', update);
    update();
  }
</script>
