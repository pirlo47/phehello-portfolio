---
---

<section id="play" class="wrap section" aria-labelledby="play-title">
  <h2 id="play-title" class="title">Play</h2>
  <p class="muted intro">Make this site your own. More options coming soon.</p>

  <div class="grid">
    <article class="card tile reveal">
      <div class="swatches" aria-hidden="true">
        <span style="background:#0a0a0a"></span>
        <span style="background:#f3f1ec"></span>
        <span style="background:#f5a742"></span>
      </div>
      <h3 class="label">Palette</h3>
      <p class="muted text">Too dark in here? Switch between dark and light mode. Your choice is remembered next time.</p>
      <button class="toggle" data-theme-toggle role="switch" aria-checked="false">
        <span class="track" aria-hidden="true"><span class="thumb"></span></span>
        <span data-theme-label>Light mode</span>
      </button>
    </article>
  </div>
</section>

<style>
  .title {
    font-size: clamp(2rem, 4vw, 3rem);
    font-weight: 300;
    letter-spacing: -0.03em;
    margin-bottom: 1rem;
  }
  .intro {
    font-size: 0.9rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(18rem, 1fr));
    gap: 0.75rem;
  }
  .tile {
    display: flex;
    flex-direction: column;
    padding: 1.75rem;
    min-height: 18rem;
  }
  .swatches {
    display: flex;
    margin-bottom: auto;
    padding-bottom: 2rem;
  }
  .swatches span {
    width: 2.25rem;
    height: 2.25rem;
    border-radius: 50%;
    border: 2px solid var(--surface);
    box-shadow: 0 0 0 1px var(--line);
  }
  .swatches span + span {
    margin-left: -0.6rem;
  }
  .label {
    margin-bottom: 0.4rem;
  }
  .text {
    font-size: 0.85rem;
    margin-bottom: 1.5rem;
  }
  .toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.85rem;
    font-weight: 400;
    align-self: flex-start;
  }
  .track {
    position: relative;
    width: 2.75rem;
    height: 1.5rem;
    border-radius: 999px;
    background: var(--surface-2);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: background-color 0.3s;
  }
  .thumb {
    position: absolute;
    top: 0.2rem;
    left: 0.2rem;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 50%;
    background: var(--text);
    transition: transform 0.4s var(--ease);
  }
  .toggle[aria-checked='true'] .track {
    background: var(--accent);
  }
  .toggle[aria-checked='true'] .thumb {
    transform: translateX(1.25rem);
    background: var(--surface);
  }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (btn) {
    const root = document.documentElement;
    const sync = () => btn.setAttribute('aria-checked', String(root.dataset.theme === 'light'));
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'light' ? 'dark' : 'light';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {}
      sync();
    });
    sync();
  }
</script>
